## C. 예시 1) `user` 도메인 패턴(실제 코드 스타일)

### 폴더 구조(권장)

- `api/user/api.model.ts` : 응답/요청 타입
- `api/user/api.type.ts` : alias
- `api/user/getUserInfo.ts` : 실제 ky 호출(authApi)
- `api/user/patchMember.ts` / `patchPassword.ts` / `postProfileFile.ts`
- `api/user/api.query.ts` : React Query 옵션 묶음

### `getUserInfo.ts` (endpoint 함수) 작성 프롬프트

- `authApi.get`를 사용하고 `ApiResult<getUserInfoResponse>` 반환.
- endpoint 문자열은 서버 라우트에 맞춰 하드코딩(프로젝트는 이런 패턴이 일반적).

```ts
import type { ApiResult } from "@/api/config/api-client-handler";
import { authApi } from "@/api/config/api-client-method";
import type { getUserInfoResponse } from "./api.model";

export function getUserInfo(): Promise<ApiResult<getUserInfoResponse>> {
  return authApi.get<getUserInfoResponse>("member/me");
}
```

### `api.query.ts` (React Query 옵션) 작성 프롬프트

- queryKey는 도메인별 prefix 배열을 `as const`로 둔다.
- queryFn 내부에서 `res.ok` 확인 후:
  - 실패면 `throw`해서 에러 토스트/에러 바운더리로 넘기는 스타일을 사용 가능.

```ts
import { mutationOptions, queryOptions } from "@tanstack/react-query";
import { TOAST_MESSAGES } from "@/constants";
import { showErrorToast } from "@/utils/toast";

import { getUserInfo } from "./getUserInfo";
import type {
  getUserInfoResponse,
  PatchMemberRequest,
  PatchPasswordRequest,
  ProfileFileResponse,
} from "./api.model";
import { patchMember } from "./patchMember";
import { patchPassword } from "./patchPassword";
import { postProfileFile } from "./postProfileFile";

const userQueryKey = ["user"] as const;

export const userQueries = {
  all: userQueryKey,
  infoKey: () => [...userQueryKey, "info"] as const,

  getUserInfoQuery: () =>
    queryOptions<getUserInfoResponse>({
      queryKey: userQueries.infoKey(),
      queryFn: async () => {
        const res = await getUserInfo();
        if (!res.ok) throw new Error("사용자 정보 조회에 실패했습니다.");
        return res.data;
      },
    }),

  postProfileFileMutation: mutationOptions<ProfileFileResponse, Error, File>({
    mutationFn: async (file: File) => {
      const res = await postProfileFile(file);
      if (!res.ok) throw new Error("프로필 이미지 업로드에 실패했습니다.");
      return res.data.data;
    },
    onError: () => showErrorToast(TOAST_MESSAGES.PROFILE_IMAGE_UPDATE),
  }),

  patchMemberMutation: mutationOptions<
    unknown,
    Error,
    { memberId: string; body: PatchMemberRequest }
  >({
    mutationFn: ({ memberId, body }) => patchMember(memberId, body),
    onError: () => showErrorToast(TOAST_MESSAGES.PROFILE_UPDATE),
  }),

  patchPasswordMutation: mutationOptions<
    unknown,
    Error,
    { memberId: string; body: PatchPasswordRequest }
  >({
    mutationFn: ({ memberId, body }) => patchPassword(memberId, body),
    onError: () => showErrorToast(TOAST_MESSAGES.PASSWORD_UPDATE),
  }),
};
```

